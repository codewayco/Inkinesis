# Copy to .env. Never commit credentials. Restart npm run dev after changing these.
# Both providers are needed for generation from an image or a text prompt.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Legacy aliases OPEN_AI_API_KEY and LLM_API_KEY are accepted for the image API.
# Set actual model IDs enabled for your accounts; no organization-only default.
RIG_ANALYSIS_MODEL=
IMAGE_MODEL=
# Optional experimental visual QA model; defaults to RIG_ANALYSIS_MODEL.
# RIG_QUALITY_MODEL=

# GPU selection for UI generation: local (default), h100-first, or h100.
# h100-first falls back once to a configured local GPU; h100 fails without fallback.
RIG_GPU_BACKEND=local
# Local See-through device: cuda (NVIDIA/Linux) or mps (Apple Silicon/macOS).
# Default is mps on macOS, cuda elsewhere. CPU inference is not implemented.
# RIG_DEVICE=cuda
# RIG_DIRECT_PYTHON=.venv/bin/python
# RIG_LOCAL_PYTHON=.venv-gen/bin/python
# RIG_DIRECT_ENGINE=.cache/rig/psd2live
# RIG_DIRECT_SEE_THROUGH=.cache/rig/see-through
# RIG_DIRECT_MODELS=.cache/rig/models
# JDK 21: JAVA_HOME is also accepted. Override for your actual installation.
# RIG_JAVA_HOME=/path/to/jdk-21
# RIG_VERIFIER=tools/verify/inochi-puppet/inochi-puppet-check
# Saved UI runs and default CLI outputs. Relative to the repository root.
# RIG_OUTPUT_DIR=outputs

# Optional H100/JupyterHub transport. Only decomposition runs remotely.
# Start jupyterBridge.py separately; enter the token at its hidden prompt.
# RIG_H100_QUEUE=.cache/rig/h100-queue
# Absolute filesystem paths on YOUR server (not URLs):
# RIG_REMOTE_ROOT=/home/your-user/inkinesis-gpu
# RIG_REMOTE_CONTENTS_ROOT=/home/your-user
# ROOT must be inside the Contents API root. See docs/instructions/remote_gpu.md.

# Optional official Cubism Core validation (SDK installed separately):
# CUBISM_REFERENCE_MODEL=/path/to/export/model
# CUBISM_REFERENCE_PORT=5190

# Optional published example avatar release. No account is needed for a public release.
# Leave unset before publishing; already installed avatars still work.
# INKINESIS_AVATAR_RELEASE_URL=https://github.com/OWNER/REPO/releases/download/avatars-v1

# Optional compatibility with a running older Jupyter bridge that requires relative mkdir paths.
# Set to the kernel's actual os.getcwd(); remote jobs must be inside this directory.
# RIG_REMOTE_KERNEL_ROOT=/home/your-user
