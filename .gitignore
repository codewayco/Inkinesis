# Dependencies, generated files, and private credentials
node_modules/
dist/
.venv*/
__pycache__/
*.pyc
.DS_Store
.vite/
.cache/
.env
.env.*
!.env.example
*.pem
*.key
# Optional private models, downloads, and authoring outputs
assets/thirdparty/
public/avatars/
outputs/
tmp/

# Native verifier build products and staged upstream source
**/.dub/
tools/verify/inochi-puppet/.inochi2d/
tools/verify/inochi-puppet/inochi-puppet-check
*.o
*.obj

# Optional example payloads are downloaded from Releases, never committed.
example-avatars/**/*.inp
example-avatars/**/*.zip
example-avatars/.downloads/
# Local export workspaces include large models, textures and private build reports.
example-avatars/*/export-*/

# Local paper drafts and publication materials
/paper/

# Private research workspace; excluded from publication.
/research/

# Local source workspaces for the published example avatars.
/old-avatars-v0.2/
/new-avatars-v0.2/
/stress-examples/
/anime-avatars/

# Evaluated avatars that are not shipped with the UI (kept locally for the README gallery and showcase video).
/other-avatars/
