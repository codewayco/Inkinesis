{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictFunctionTypes": false,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@cubism/*": [
        "../../assets/thirdparty/cubism_sdk/CubismSdkForWeb-5-r.5/Framework/src/*"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vite.config.ts",
    "runCombinedCapture.ts",
    "../../assets/thirdparty/cubism_sdk/CubismSdkForWeb-5-r.5/Core/live2dcubismcore.d.ts"
  ]
}
